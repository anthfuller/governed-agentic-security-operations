  "properties": {
    "artifact_type": {"const": "governed_action_request"},
    "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
    "request_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "correlation_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "profile": {"enum": ["MSSP", "MDR", "DFIR"]},
    "action": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "tool_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "target_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "parameters": {"type": "object"},
    "scope": {"$ref": "common-defs.schema.json#/$defs/scope"},
    "requested_at": {"$ref": "common-defs.schema.json#/$defs/timestamp"},
    "external_action_executed": {"const": false}
  }
}
