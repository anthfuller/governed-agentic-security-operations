{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/adr.schema.json",
  "title": "Architecture Decision Record",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "adr_id", "title", "status", "context", "decision", "consequences", "alternatives", "deciders", "decided_at"],
  "properties": {
    "artifact_type": {"const": "architecture_decision_record"},
    "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
    "adr_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]},
    "context": {"type": "string", "minLength": 10},
    "decision": {"type": "string", "minLength": 10},
    "consequences": {"$ref": "common-defs.schema.json#/$defs/stringList"},
    "alternatives": {"$ref": "common-defs.schema.json#/$defs/stringList"},
    "deciders": {"$ref": "common-defs.schema.json#/$defs/stringList"},
    "decided_at": {"$ref": "common-defs.schema.json#/$defs/timestamp"}
  }
}
