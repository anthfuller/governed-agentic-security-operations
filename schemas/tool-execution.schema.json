{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/tool-execution.schema.json",
  "title": "Tool Execution Request or Imported Result",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "request_id", "correlation_id", "tool_id", "tool_version", "operation", "target_id", "parameters", "scope", "policy_decision_id", "approval_ids", "execution_mode"],
      "properties": {
        "artifact_type": {"const": "tool_execution_request"},
        "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
        "request_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "correlation_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "tool_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "tool_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
        "operation": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "target_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "parameters": {"type": "object"},
        "scope": {"$ref": "common-defs.schema.json#/$defs/scope"},
        "policy_decision_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "approval_ids": {"$ref": "common-defs.schema.json#/$defs/stringList"},
        "execution_mode": {"const": "validate_only"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "execution_id", "request_id", "status", "recorded_at", "source_system", "external_receipt_reference"],
      "properties": {
        "artifact_type": {"const": "tool_execution_result"},
        "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
        "execution_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "request_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
        "status": {"enum": ["not_executed", "succeeded", "failed", "denied"]},
        "recorded_at": {"$ref": "common-defs.schema.json#/$defs/timestamp"},
        "source_system": {"type": "string", "minLength": 2},
        "external_receipt_reference": {"type": ["string", "null"]}
      }
    }
  ]
}
