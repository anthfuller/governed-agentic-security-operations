{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/derived-artifact.schema.json",
  "title": "Derived Artifact Lineage Record",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "derived_artifact_id", "scope", "classification", "source_evidence_ids", "transformation", "producer", "hash_algorithm", "hash_value", "created_at", "review_status"],
  "properties": {
    "artifact_type": {"const": "derived_artifact_lineage"},
    "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
    "derived_artifact_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "scope": {"$ref": "common-defs.schema.json#/$defs/scope"},
    "classification": {"const": "derived_artifact"},
    "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "transformation": {"type": "string", "minLength": 3},
    "producer": {"type": "string", "minLength": 3},
    "hash_algorithm": {"const": "sha256"},
    "hash_value": {"$ref": "common-defs.schema.json#/$defs/sha256"},
    "created_at": {"$ref": "common-defs.schema.json#/$defs/timestamp"},
    "review_status": {"enum": ["unreviewed", "reviewed", "rejected"]}
  }
}
