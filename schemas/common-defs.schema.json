{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/common-defs.schema.json",
  "title": "GASO Common Definitions",
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@/-]{2,127}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"},
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_id": {"$ref": "#/$defs/identifier"},
        "customer_id": {"$ref": "#/$defs/identifier"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "case_id": {"$ref": "#/$defs/identifier"},
        "evidence_ids": {"$ref": "#/$defs/stringList"},
        "target_ids": {"$ref": "#/$defs/stringList"},
        "environment": {"type": "string", "minLength": 2},
        "valid_from": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"$ref": "#/$defs/timestamp"}
      },
      "minProperties": 1
    },
    "humanActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "role", "is_agent"],
      "properties": {
        "identity_id": {"$ref": "#/$defs/identifier"},
        "role": {"type": "string", "minLength": 2},
        "is_agent": {"const": false}
      }
    }
  }
}
