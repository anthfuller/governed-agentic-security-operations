{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/evidence-manifest.schema.json",
  "title": "Evidence Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "manifest_id", "scope", "status", "evidence_objects", "derived_artifact_ids", "created_at", "custodian_role"],
  "properties": {
    "artifact_type": {"const": "evidence_manifest"},
    "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
    "manifest_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "scope": {"$ref": "common-defs.schema.json#/$defs/scope"},
    "status": {"enum": ["draft", "active", "sealed", "superseded"]},
    "evidence_objects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "object_type", "source", "hash_algorithm", "hash_value", "acquired_at", "custodian_role"],
        "properties": {
          "evidence_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
          "object_type": {"type": "string", "minLength": 2},
          "source": {"type": "string", "minLength": 2},
          "hash_algorithm": {"const": "sha256"},
          "hash_value": {"$ref": "common-defs.schema.json#/$defs/sha256"},
          "acquired_at": {"$ref": "common-defs.schema.json#/$defs/timestamp"},
          "custodian_role": {"type": "string", "minLength": 2}
        }
      }
    },
    "derived_artifact_ids": {"type": "array", "items": {"$ref": "common-defs.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "created_at": {"$ref": "common-defs.schema.json#/$defs/timestamp"},
    "custodian_role": {"type": "string", "minLength": 2}
  }
}
