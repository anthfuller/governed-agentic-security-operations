{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/recommendation.schema.json",
  "title": "Security Recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "recommendation_id", "producer_id", "authoritative", "scope", "recommended_action", "target_id", "evidence_ids", "summary", "limitations", "created_at"],
  "properties": {
    "artifact_type": {"const": "security_recommendation"},
    "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
    "recommendation_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "producer_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "authoritative": {"const": false},
    "scope": {"$ref": "common-defs.schema.json#/$defs/scope"},
    "recommended_action": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "target_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "summary": {"type": "string", "minLength": 5},
    "limitations": {"$ref": "common-defs.schema.json#/$defs/stringList"},
    "created_at": {"$ref": "common-defs.schema.json#/$defs/timestamp"}
  }
}
