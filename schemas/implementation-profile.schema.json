{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/implementation-profile.schema.json",
  "title": "GASO Implementation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "profile_id", "version", "title", "description",
    "applicable_controls", "conditional_controls", "roles", "prohibited_actions",
    "required_approvals", "scope_dimensions", "required_artifacts",
    "required_commands", "conformance_tests", "external_dependencies"
  ],
  "properties": {
    "artifact_type": {"const": "implementation_profile"},
    "profile_id": {"type": "string", "pattern": "^GASO-PROFILE-(MSSP|MDR|DFIR)$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "applicable_controls": {"$ref": "#/$defs/controlIds"},
    "conditional_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "condition"],
        "properties": {
          "control_id": {"$ref": "#/$defs/controlId"},
          "condition": {"type": "string", "minLength": 5}
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "responsibilities"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "responsibilities": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "prohibited_actions": {"$ref": "#/$defs/stringList"},
    "required_approvals": {"$ref": "#/$defs/stringList"},
    "scope_dimensions": {"$ref": "#/$defs/stringList"},
    "required_artifacts": {"$ref": "#/$defs/stringList"},
    "required_commands": {"$ref": "#/$defs/stringList"},
    "conformance_tests": {"$ref": "#/$defs/stringList"},
    "external_dependencies": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "controlId": {
      "type": "string",
      "pattern": "^GASO-(GOV|IDN|TEN|POL|APR|TOL|EVD|AUD|FLT|LLM|ING|ASR)-[0-9]{3}$"
    },
    "controlIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/controlId"}
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 2},
      "uniqueItems": true
    }
  }
}
