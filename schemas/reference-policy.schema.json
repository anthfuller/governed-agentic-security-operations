{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gaso/schemas/reference-policy.schema.json",
  "title": "Deterministic Reference Policy",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "policy_id", "version", "profile", "default_outcome", "decision_ttl_seconds", "actions"],
  "properties": {
    "artifact_type": {"const": "reference_policy"},
    "schema_version": {"$ref": "common-defs.schema.json#/$defs/semver"},
    "policy_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
    "version": {"$ref": "common-defs.schema.json#/$defs/semver"},
    "profile": {"enum": ["MSSP", "MDR", "DFIR"]},
    "default_outcome": {"const": "FAIL_CLOSED"},
    "decision_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "allowed", "risk_class", "required_tool_id", "required_approvals", "required_scope_fields", "allowed_parameters"],
        "properties": {
          "name": {"$ref": "common-defs.schema.json#/$defs/identifier"},
          "allowed": {"type": "boolean"},
          "risk_class": {"enum": ["read_only", "sensitive_read", "state_change", "destructive"]},
          "required_tool_id": {"$ref": "common-defs.schema.json#/$defs/identifier"},
          "required_approvals": {"type": "array", "items": {"enum": ["human", "customer"]}, "uniqueItems": true},
          "required_scope_fields": {"$ref": "common-defs.schema.json#/$defs/stringList"},
          "allowed_parameters": {"$ref": "common-defs.schema.json#/$defs/stringList"}
        }
      }
    }
  }
}
