  "sanitized_payload_summary": {
    "threat_activity_class": "cloud_identity_abuse",
    "generalized_behavior_sequence": [
      "Unusual OAuth consent grant for a newly observed application registration.",
      "Token use from an unmanaged network path shortly after consent approval.",
      "Directory and role enumeration activity inconsistent with the user's recent baseline.",
      "Attempted addition of a service principal credential after enumeration completed."
    ],
    "released_signal_definitions_requested": [
      {
        "signal_id": "released-signal-oauth-consent-0001",
        "signal_type": "identity_event_sequence",
        "description": "Detect consent grant followed by high-risk token activity and directory enumeration within a short time window.",
        "requires_recipient_tenant_adaptation": true,
        "contains_source_customer_values": false
      },
      {
        "signal_id": "released-signal-service-principal-credential-0002",
        "signal_type": "cloud_control_plane_change",
        "description": "Detect service principal credential addition when preceded by anomalous user-driven OAuth activity.",
        "requires_recipient_tenant_adaptation": true,
        "contains_source_customer_values": false
      },
      {
        "signal_id": "released-signal-directory-enumeration-0003",
        "signal_type": "directory_enumeration_pattern",
        "description": "Detect broad directory enumeration from an identity that recently approved a newly observed OAuth application.",
        "requires_recipient_tenant_adaptation": true,
        "contains_source_customer_values": false
      }
    ],
    "recommended_recipient_actions_requested": [
      "Evaluate tenant-local OAuth consent events against the released behavior sequence.",
      "Review tenant-local service principal credential changes for preceding anomalous identity activity.",
      "Escalate matching results through each tenant's normal SOC triage workflow."
    ],
